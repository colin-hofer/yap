# Relay deploy config for this repo's built-in blue/green deployer.
# Run from the repo root with:
#   go run ./cmd/deploy

DEPLOY_HOST=root@104.236.76.237
SSH_KEY=~/.ssh/ch-server

# Optional overrides:
# SSH_PORT=22
# SSH_BATCH_MODE=false
# APP_NAME=yap-relay
# BUILD_WORKDIR=.
# BUILD_PACKAGE=./cmd/yap-relay
# BLUE_ADDR=127.0.0.1:18081
# GREEN_ADDR=127.0.0.1:18082
# BLUE_HEALTH_ADDR=127.0.0.1:19081
# GREEN_HEALTH_ADDR=127.0.0.1:19082
# PUBLIC_ADDR=:4001

PUBLIC_ADDR=:4001
YAP_RELAY_PUBLIC_ADDR=/dns4/colinhofer.com/tcp/4001
YAP_RELAY_STATE_DIR=/var/lib/yap-relay/state
